# Ambiente: development | production | test
NODE_ENV=development
PORT=3100

# --- Banco de dados (Supabase / PostgreSQL) ---
# Connection string do Supabase: Project Settings -> Database -> Connection string -> URI
# (use o "Session pooler" ou a conexão direta). Contém a SENHA do banco: é um segredo.
# NÃO use as chaves anon / service_role do Supabase: o sistema fala direto com o Postgres.
# Em produção é obrigatória. Em desenvolvimento, se ficar vazia, usa um Postgres embutido (PGlite) em data/pglite.
DATABASE_URL=
# Schema próprio do app (isola de outros sistemas no mesmo banco). Veja scripts/supabase-setup.sql.
DATABASE_SCHEMA=tiktok_ads
# CA oficial do Supabase (certificado público, já incluído no projeto). A verificação do SSL nunca é desligada.
DATABASE_SSL_CA_PATH=certs/supabase-ca.crt
# DATABASE_POOL_MAX=10

# Quantos proxies reversos existem na frente do app (Render/Heroku/Nginx = 1). Com 0 o IP real não é lido de
# X-Forwarded-For (correto quando o app é acessado direto). Necessário em produção atrás de proxy para o limite de tentativas funcionar.
TRUST_PROXY=0
# Em hospedagem (container) o app precisa escutar em todas as interfaces:
# HOST=0.0.0.0

# Conta de administrador (criada/sincronizada na inicialização).
# O e-mail de admin NÃO pode ser usado no cadastro público.
ADMIN_EMAIL=contato.guilhermecostas@gmail.com
# Mínimo 10 caracteres. Defina uma senha forte e exclusiva.
ADMIN_PASSWORD=

# --- Integração TikTok (Business Centers) ---
# Chave que criptografa os tokens das Business Centers no banco (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Conexão por link (recomendado) ---
# App do TikTok (API for Business) usado para o usuário autorizar o acesso à própria Business Center por um link.
# Crie em https://business-api.tiktok.com/portal/apps (Meus apps -> Criar app) e, no app, registre a URI de retorno
# (Redirect URL) EXATAMENTE igual a TIKTOK_REDIRECT_URI. App ID e Secret são SEGREDOS do servidor.
# Sem estas variáveis o botão continua funcionando pelo token manual.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Endereço público do sistema + /api/tiktok/callback (em produção precisa ser https). Padrão: http://localhost:PORT/api/tiktok/callback
TIKTOK_REDIRECT_URI=

# --- Biblioteca de criativos (arquivos guardados no servidor, por usuário) ---
# CREATIVES_DIR=data/creatives
# CREATIVES_MAX_IMAGE_MB=10
# CREATIVES_MAX_VIDEO_MB=200
# CREATIVES_USER_QUOTA_MB=2048
# Limpeza dos criativos a cada publicação (FFmpeg vem no pacote ffmpeg-static; FFMPEG_PATH só se quiser outro binário).
# CREATIVES_CLEAN_CONCURRENCY=1   # limpezas ao mesmo tempo (a CPU do servidor é compartilhada)
# CREATIVES_CLEAN_TIMEOUT_MIN=20  # tempo máximo por arquivo
# CREATIVES_CLEAN_THREADS=2       # threads do codificador (limita CPU e memória)
# FFMPEG_PATH=/usr/bin/ffmpeg

